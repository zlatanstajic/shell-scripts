#!/bin/bash

################################################################################
# Script name : .githooks/pre-commit
# Description : Git pre-commit hook. Runs the same three checks as the GitHub
#               Actions CI workflow - tests, generated-docs drift, shellcheck -
#               so failures surface locally first.
#               Enable per clone with: git config core.hooksPath .githooks
#
#               Enforcement differs from CI on purpose. In CI all three are
#               hard gates. Here only the test suite blocks a commit; docs
#               drift and shellcheck warn. A local hook must not block on a
#               developer's own .env (gen-docs.sh runs every script's -h,
#               which sources it) or on a missing/older shellcheck. CI is the
#               enforcement boundary; this hook is the fast heads-up.
# Author      : Zlatan Stajic <contact@zlatanstajic.com>
# License     : MIT
################################################################################

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# Hard gate: tests must pass.
echo "pre-commit: running tests"
if ! bash tests/run.sh
then
  echo "pre-commit: tests FAILED - commit aborted" >&2
  exit 1
fi

# Advisory here, hard gate in CI. See the header note: this must not block a
# commit because of the developer's local .env.
echo "pre-commit: checking generated docs reference (advisory)"
bash src/scripts/gen-docs.sh --check || \
  echo "pre-commit: generated docs out of date - run bash src/scripts/gen-docs.sh (not blocking)" >&2

# Advisory here, hard gate in CI (which pins the shellcheck version). Warn,
# never block: a local shellcheck may be absent or a different version.
if command -v shellcheck >/dev/null 2>&1
then
  echo "pre-commit: running shellcheck (advisory)"
  shellcheck src/scripts/*.sh src/lib/common.sh install.sh uninstall.sh || \
    echo "pre-commit: shellcheck warnings above (not blocking)" >&2
else
  echo "pre-commit: shellcheck not installed - skipping lint"
fi

exit 0

################################################################################
